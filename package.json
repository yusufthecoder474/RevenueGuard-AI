{
  "name": "revenueguard-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.frontend.json",
    "build": "node scripts/build.mjs && wrangler deploy --dry-run --outdir dist-worker",
    "test": "vitest run",
    "test:workers": "node scripts/integration.mjs",
    "benchmark": "node --import tsx scripts/benchmark.ts",
    "db:local": "wrangler d1 migrations apply revenueguard --local",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "decimal.js": "10.6.0",
    "papaparse": "5.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261023.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/papaparse": "5.5.2",
    "esbuild": "0.25.12",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "wrangler": "4.152.0"
  }
}
